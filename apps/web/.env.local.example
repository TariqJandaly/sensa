# Better Auth
BETTER_AUTH_URL=http://localhost:3123
# generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Postgres (docker compose at repo root, published on 127.0.0.1:5434)
# the password the dev compose sets is in docker-compose.yml
DATABASE_URL="postgresql://sensa:CHANGE_ME@127.0.0.1:5434/sensa"

# MQTT broker (device ingestion bridge)
MQTT_URL=mqtt://localhost:1883

# Web Push VAPID (generate: bunx web-push generate-vapid-keys)
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:you@example.com
